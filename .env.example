# Переменные для docker-compose (не путать с back/.env — там ключи приложения).
# Скопировать в .env рядом:  cp .env.example .env

# Пароль Postgres в контейнере. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Пусто/не задано — слушаем :80 без HTTPS (локальная проверка).
# Домен (crm.example.com) — Caddy сам выпустит Let's Encrypt-сертификат.
SITE_ADDRESS=

# Тот же ID, что в front/.env — вшивается в бандл при сборке.
VITE_GOOGLE_CLIENT_ID=
