TOKEN=your_telegram_bot_token
WEB_APP_URL=https://your-domain/
# Публичный адрес бэкенда для server_callback вебхука Fondy (дев: туннель ngrok на :8000).
BACKEND_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/your_db
GEMINI_API_KEY=your_gemini_api_key
SECRET_KEY=change_me_in_production
GOOGLE_CLIENT_ID=your_google_oauth_client_id
# Google Calendar OAuth (эпик 6, задача 4): Authorization Code + offline, отдельно от
# входа через Google выше — тот проверяет id_token по публичным ключам и секрета не
# требует, а обмен code -> refresh_token на сервере без client_secret невозможен.
# Тот же GOOGLE_CLIENT_ID подходит, если в консоли Google это OAuth-клиент типа Web application.
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/settings/integrations/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
TG_BOT_TOKEN=your_telegram_bot_token
# Fondy: тестовый мерчант = 1396424 / test. Боевые получишь после верификации.
FONDY_MERCHANT_ID=1396424
FONDY_MERCHANT_PASSWORD=test
# Валюта списания = валюта студии (онбординг). Fondy рассчитывает в 6 валютах: UAH, EUR, USD, GBP, PLN, CZK (RUB нет). Ниже — дефолт/фолбэк.
FONDY_CURRENCY=UAH
# Velora AI (эпик AI-1): пусто = честная заглушка вместо ответа модели. Заданный
# LLM_BASE_URL — любой OpenAI-совместимый сервер (например, локальная Ollama).
LLM_BASE_URL=
LLM_MODEL=gpt-4o
# Instagram OAuth для авто-ответчика (эпик AI-3): тестовое Meta-приложение,
# redirect_uri должен побайтово совпадать со значением в Meta-консоли.
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:8000/ai/instagram/callback
# Произвольная строка; ту же вписать в поле Verify token вебхука в Meta-консоли.
# Не переиспользовать SECRET_KEY: verify-токен видно в панели Meta.
IG_VERIFY_TOKEN=
# WhatsApp-агент: подпись и verify-токен вебхука Cloud API. Токен и номер студии
# приходят не отсюда, а из интеграции wa_notify (Уведомления → WhatsApp).
WA_APP_SECRET=
WA_VERIFY_TOKEN=
