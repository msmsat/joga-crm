TOKEN=your_telegram_bot_token
WEB_APP_URL=https://your-domain/
# Публичный адрес бэкенда для server_callback вебхука Fondy и для вебхука Telegram
# (/booking/telegram/webhook/{token}, отвечает на /start) — дев: туннель ngrok на :8000,
# Telegram на localhost стучаться не умеет.
BACKEND_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/your_db
GEMINI_API_KEY=your_gemini_api_key
# Подпись JWT. Обязателен — без него приложение не стартует. Значение из примера
# или из репозитория не годится: кто его знает, тот выпишет себе токен владельца
# любой студии. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Ключ шифрования секретов в БД (токены Telegram и Instagram, services/crypto.py).
# Можно НЕ задавать — тогда ключ выводится из SECRET_KEY, и шифрование работает
# всегда, а не только там, где переменную не забыли. Задавать имеет смысл ради
# ротации SECRET_KEY отдельно от токенов: сменив SECRET_KEY без этой переменной,
# вы делаете уже сохранённые токены нечитаемыми, и студии переподключают каналы.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Домены фронта, которым разрешён CORS (через запятую). Не задан — берётся WEB_APP_URL.
# Клиентское мини-приложение — ОТДЕЛЬНЫЙ origin от CRM: с тех пор как в него можно
# войти из браузера (`/s/<studio_id>`, вход по коду на почту), его адрес обязан быть
# в этом списке, иначе запросы упрутся в CORS. Dev: http://localhost:5174
CORS_ORIGINS=
# Публичный адрес клиентского мини-приложения (без хвостового слэша). Нужен ровно для
# одного: вернуть с хостед-страницы Stripe того, кто платил ИЗ БРАУЗЕРА, обратно во
# вкладку, а не в Telegram (routers/booking/miniapp_users.py:_checkout_return_base).
# Не задан — возврат всегда в t.me, как было до веб-входа.
MINIAPP_URL=http://localhost:5174
GOOGLE_CLIENT_ID=your_google_oauth_client_id
# Google Calendar OAuth (эпик 6, задача 4): Authorization Code + offline, отдельно от
# входа через Google выше — тот проверяет id_token по публичным ключам и секрета не
# требует, а обмен code -> refresh_token на сервере без client_secret невозможен.
# Тот же GOOGLE_CLIENT_ID подходит, если в консоли Google это OAuth-клиент типа Web application.
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/settings/integrations/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
TG_BOT_TOKEN=your_telegram_bot_token
# Валюта счетов за тариф (оплата подписки на саму Velora). Цены в
# routers/billing/plans.py заданы в МЛАДШИХ единицах, поэтому валюта без младших
# единиц (JPY и подобные) сюда не годится — сумма уедет в 100 раз.
BILLING_CURRENCY=eur
# Ставка НДС ДЛЯ ПОКАЗА в интерфейсе, %. Итоговую сумму всегда считает Stripe Tax
# по стране плательщика — здесь только ориентир для подписи «включая НДС N%».
BILLING_VAT_RATE=21
# Страна продавца. Проверяется preflight'ом: без активной регистрации этой страны
# в Stripe Tax счета уходят с НДС 0 %, а налог налоговая всё равно спросит.
BILLING_HOME_COUNTRY=CZ
# Куда платформа получает уведомления о собственном доходе (оплата тарифа, комиссия).
# Пусто — уведомления не шлются; на приём денег это не влияет.
PLATFORM_BILLING_EMAIL=
# Подпись вебхука оплаты тарифа (эндпоинт /billing/webhook/stripe). Это ОТДЕЛЬНЫЙ
# эндпоинт от кассы, значит в дашборде Stripe у него свой секрет — на проде задать
# обязательно, иначе один секрет обслуживает оба эндпоинта (в логах error на старте).
# Пусто = берётся STRIPE_WEBHOOK_SECRET, чтобы локально хватало одного `stripe listen`.
# В дашборде у этого эндпоинта НЕ включать «Listen to events on connected accounts»:
# тариф платят платформе, события подключённых аккаунтов обработчик отбрасывает.
STRIPE_BILLING_WEBHOOK_SECRET=
# Stripe Connect: приём оплат клиентов НА СЧЁТ СТУДИИ (платформа денег не держит).
# Это секретный ключ ПЛАТФОРМЫ (Developers → API keys), а не студии: ключи студий
# мы не храним вообще — вместо них acct_… в online_channels.account_id.
STRIPE_SECRET_KEY=
# Публичный ключ той же платформы (pk_...). Уезжает во фронт вместе с сессией —
# им поднимается встроенная форма оплаты. Публичный по определению, не секрет.
STRIPE_PUBLISHABLE_KEY=
# Подпись вебхука. Локально выдаётся командой:
#   stripe listen --forward-to localhost:8000/checkout/webhook/stripe --events checkout.session.completed
# Пусто = вебхук отклоняет всё (оплата подтвердится только возвратом на success_url).
STRIPE_WEBHOOK_SECRET=
# Velora AI (эпик AI-5). Один ключ на ВСЮ платформу, не на студию: ИИ оплачен
# тарифом, свои ключи студии не заводят. Пусто (любая из двух переменных) =
# честная заглушка вместо ответа модели — локальная разработка и тесты работают
# без ключа, а 503 приходит только когда провайдер задан и не отвечает.
# Боевое значение LLM_BASE_URL: https://openrouter.ai/api
LLM_BASE_URL=
LLM_API_KEY=
# Слаги сверять на openrouter.ai/models ПОБАЙТОВО — они меняются между релизами.
# Заодно сверять цены с таблицей _PRICES в services/llm.py: на неверных ставках
# весь учёт денег в ai_usage — фикция. Ниже — сверено живым запросом 2026-08-18.
#
# FAST обязан уметь вызывать инструменты (supported_parameters содержит "tools"):
# модель без них отвечает прозой на КАЖДЫЙ вопрос, окно подтверждения не
# появляется ни разу, и выглядит это как «ассистент отказывается работать».
LLM_MODEL_FAST=google/gemini-3.7-flash
LLM_MODEL_MAIN=anthropic/claude-sonnet-5
LLM_MODEL_SMART=anthropic/claude-opus-5
# Instagram OAuth для авто-ответчика (эпик AI-3): тестовое Meta-приложение,
# redirect_uri должен побайтово совпадать со значением в Meta-консоли.
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:8000/ai/instagram/callback
# Произвольная строка; ту же вписать в поле Verify token вебхука в Meta-консоли.
# Не переиспользовать SECRET_KEY: verify-токен видно в панели Meta.
IG_VERIFY_TOKEN=
# WhatsApp: подпись и verify-токен вебхука Cloud API. Токен и номер студии
# приходят не отсюда, а из интеграции wa_notify (Embedded Signup или руками).
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Embedded Signup (кнопка «Подключить WhatsApp» на странице Velora AI). ВАЖНО: это
# App ID/Secret приложения из Settings → Basic, а НЕ инстаграмные IG_APP_ID/IG_APP_SECRET
# выше — у «Instagram API with Instagram login» свои отдельные ключи и своя подпись
# вебхука. Приложение может быть то же самое, ключи — разные.
WA_APP_ID=
# Configuration ID конфигурации Facebook Login for Business с вариантом
# WhatsApp Embedded Signup. Redirect URI должен побайтово совпадать со значением
# в списке Valid OAuth Redirect URIs в Meta-консоли.
WA_CONFIG_ID=
WA_REDIRECT_URI=http://localhost:8000/ai/whatsapp/callback
# 6 цифр: PIN двухфакторки, которым регистрируется номер в Cloud API.
WA_REGISTER_PIN=000000
