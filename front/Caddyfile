# SITE_ADDRESS не задан -> слушаем :80 (локально). Задан домен (crm.example.com)
# -> Caddy сам получит и продлит Let's Encrypt-сертификат, certbot не нужен.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# Фронт и API на одном домене: CORS не участвует вообще.
	# handle_path срезает /api, бэкенд получает свои родные пути (/auth, /clients, /static).
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Второй домен (api.example.com) — тот же бэкенд, но БЕЗ среза префикса: мини-ап
# (/s/{id}) и вебхуки Telegram, Meta и Stripe знают голые пути. В основной блок их
# не увести — там handle_path режет /api, а остальное отдаёт index.html фронта.
# Переменной нет (локально) -> :8080, порт наружу не проброшен и никому не мешает.
{$API_ADDRESS::8080} {
	encode gzip zstd
	reverse_proxy api:8000
}
