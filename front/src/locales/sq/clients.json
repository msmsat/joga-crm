  "categoriesInfo": {
    "all": {
      "text": "Lista e plotë e klientëve të studios, pa filtër statusi të aplikuar."
    },
    "vip": {
      "text": "Pagesa të suksesshme me vlerë totale 50 000+ ose 30+ vizita. VIP mund të fiksohet edhe manualisht në kartën e klientit; fiksimi manual mbetet pavarësisht shumave."
    },
    "active": {
      "text": "Të paktën një vizitë në 60 ditët e fundit. Bazohet në pjesëmarrjen e shënuar në ditar — statusi përditësohet vetë, pa pasur nevojë të caktohet me dorë."
    },
    "new": {
      "text": "15 ditët e para nga data e regjistrimit, pavarësisht nëse klienti u shtua manualisht apo erdhi nga rezervimi online. Në ditën e 16-të kalon automatikisht te Aktiv ose Joaktiv."
    },
    "has_subscription": {
      "text": "Ka abonim aktiv: jo të skaduar, jo të ngrirë dhe me seanca të mbetura. Përditësohet menjëherë në blerje, pas çdo seance të përdorur dhe kur skadon."
    },
    "inactive": {
      "text": "Pa vizita në 60 ditët e fundit — ose pa vizituar kurrë dhe kanë kaluar mbi 15 ditë nga regjistrimi."
    },
    "frozen": {
      "text": "I ngrirë nga butoni në kartën e klientit — i vetmi status që caktohet me dorë. Pas çngrirjes, klienti kthehet te statusi automatik."
    },
    "birthday": {
      "text": "Ata që kanë ditëlindjen sot — dita dhe muaji përputhen, viti shpërfillet. Lista rifreskohet automatikisht çdo ditë."
    }
  },
